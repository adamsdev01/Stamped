@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Stamp It!</PageTitle>

<header class="masthead">
    <div>
        <div class="brand-mark">Stamp It!</div>
        <div class="brand-sub">Job Application Portal</div>
    </div>
</header>

<main>

    <!-- Step 1: Upload + parse resume -->
    <div class="step">
        <div class="step-head">
            <div class="step-title"><span class="step-num">1</span> Your resume</div>
            <span class="tool-badge">parseResume()</span>
        </div>

        <div class="dropzone">
            <div class="dropzone-icon">PDF</div>
            <div class="dropzone-text">
                <strong>Upload your resume</strong>
                <span>PDF only</span>
            </div>
            <InputFile class="file-input" OnChange="HandleFileSelected" accept=".pdf" />
        </div>

        @if (isProcessing)
        {
            <div class="status-line"><span class="spinner"></span> @statusText</div>
        }

        @if (parsedResume is not null)
        {
            <div class="summary-grid">
                <div class="summary-field">
                    <label>Most recent role</label>
                    <div>@parsedResume.MostRecentRole</div>
                </div>
                <div class="summary-field">
                    <label>Years of experience</label>
                    <div>@parsedResume.YearsExperience</div>
                </div>
                <div class="summary-field full">
                    <label>Skills found</label>
                    <div class="tag-row">
                        @foreach (var skill in parsedResume.Skills)
                        {
                            <span class="tag">@skill</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Step 2: Match jobs -->
    <div class="step @(parsedResume is null ? "locked" : "")">
        <div class="step-head">
            <div class="step-title"><span class="step-num">2</span> Matches</div>
            <span class="tool-badge">matchJobs()</span>
        </div>

        @if (matches.Any())
        {
            <div class="folder-list">
                @foreach (var m in matches)
                {
                    <div class="folder">
                        <div class="match-score">@m.MatchScore%</div>
                        <div class="folder-body">
                            <div class="role">@m.JobPosting.Title</div>
                            <div class="company">@m.JobPosting.Company — @m.JobPosting.Location</div>
                            <div class="reasoning">@m.Reasoning</div>
                        </div>
                        <button class="btn-draft" @onclick="() => DraftLetter(m)">Draft letter</button>
                    </div>
                }
            </div>
        }
        else if (parsedResume is not null && !isProcessing)
        {
            <p class="empty-note">No matches yet.</p>
        }
    </div>

    <!-- Step 3: Draft cover letter -->
    @if (currentApplication is not null)
    {
        <div class="step">
            <div class="step-head">
                <div class="step-title"><span class="step-num">3</span> Cover letter — @currentApplication.JobMatch.JobPosting.Title</div>
                <span class="tool-badge">draftCoverLetter()</span>
            </div>
            <div class="letter">
                <div class="letterhead">
                    <span>Status: @currentApplication.Status</span>
                    <span>@currentApplication.JobMatch.JobPosting.Company</span>
                </div>
                <pre>@currentApplication.CoverLetter</pre>
            </div>
        </div>

        <!-- Step 4: human approval -->
        <div class="step approval-panel">
            <div class="eyebrow">Human sign-off required</div>
            <div class="step-title center">Review &amp; submit</div>

            @if (currentApplication.Status == ApplicationStatus.Draft)
            {
                <p class="desc">This is the one step your agent can't take for you.</p>
                <div class="stamp-zone">
                    <button class="stamp-btn" @onclick="SubmitApplication">Approve<br />&amp; submit</button>
                </div>
                <span class="tool-badge human">submitApplication() — human only, no tool registered</span>
            }
            else if (currentApplication.Status == ApplicationStatus.Submitted)
            {
                <p class="submitted-note">Submitted at @currentApplication.SubmittedAt</p>
            }
        </div>
    }

</main>

<footer>WebMcp - Every tool above is agent-callable except the stamp — that one belongs to you.</footer>

@code {
    private bool isProcessing;
    private string statusText = "";
    private Resume? parsedResume;
    private List<JobMatch> matches = new();
    private JobApplication? currentApplication;
    private byte[]? uploadedPdfBytes;
    private string uploadedFileName = "";

    private IJSObjectReference? _module;
    private DotNetObjectReference<Home>? _dotNetRef;
    private IJSObjectReference? _siteModule;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var stream = file.OpenReadStream(maxAllowedSize: 10_000_000);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        uploadedPdfBytes = ms.ToArray();
        uploadedFileName = file.Name;

        await ParseResumeAsync();
        await MatchJobsAsync();
    }

    private async Task<Resume> ParseResumeAsync()
    {
        if (uploadedPdfBytes is null) throw new InvalidOperationException("No resume uploaded yet.");

        isProcessing = true;
        statusText = "Reading resume...";
        await InvokeAsync(StateHasChanged);

        using var ms = new MemoryStream(uploadedPdfBytes);
        parsedResume = await ResumeParser.ParseAsync(ms, uploadedFileName);
        Db.Resumes.Add(parsedResume);
        await Db.SaveChangesAsync();

        isProcessing = false;
        await InvokeAsync(StateHasChanged);
        return parsedResume;
    }

    private async Task<List<JobMatch>> MatchJobsAsync()
    {
        if (parsedResume is null) throw new InvalidOperationException("Parse the resume first.");

        isProcessing = true;
        statusText = "Searching jobs...";
        await InvokeAsync(StateHasChanged);

        var query = parsedResume.MostRecentRole;
        var location = JobOptions.Value.DefaultLocation;
        var fetched = await JobSource.SearchAsync(query, location);

        foreach (var job in fetched)
        {
            var exists = Db.JobPostings.Any(j => j.ExternalId == job.ExternalId && job.ExternalId != "");
            if (!exists) Db.JobPostings.Add(job);
        }
        await Db.SaveChangesAsync();

        statusText = "Matching jobs...";
        await InvokeAsync(StateHasChanged);

        var jobs = Db.JobPostings.Where(j => j.Source == "adzuna").ToList();
        var results = await JobMatcher.MatchAsync(parsedResume, jobs);

        Db.JobMatches.AddRange(results);
        await Db.SaveChangesAsync();

        matches = Db.JobMatches
            .Where(m => m.ResumeId == parsedResume.Id)
            .OrderByDescending(m => m.MatchScore)
            .Select(m => new JobMatch
            {
                Id = m.Id,
                MatchScore = m.MatchScore,
                Reasoning = m.Reasoning,
                JobPosting = Db.JobPostings.First(j => j.Id == m.JobPostingId)
            })
            .ToList();

        isProcessing = false;
        await InvokeAsync(StateHasChanged);
        return matches;
    }

    private async Task<string> DraftCoverLetterAsync(int jobMatchId)
    {
        var match = matches.FirstOrDefault(m => m.Id == jobMatchId)
            ?? throw new InvalidOperationException($"No match with id {jobMatchId}.");

        isProcessing = true;
        statusText = "Drafting cover letter...";
        await InvokeAsync(StateHasChanged);

        var letter = await CoverLetterDrafter.DraftAsync(parsedResume!, match.JobPosting);

        var application = new JobApplication { JobMatchId = match.Id, CoverLetter = letter, Status = ApplicationStatus.Draft };
        Db.Applications.Add(application);
        await Db.SaveChangesAsync();

        currentApplication = new JobApplication { Id = application.Id, CoverLetter = letter, Status = application.Status, JobMatch = match };

        isProcessing = false;
        await InvokeAsync(StateHasChanged);
        return letter;
    }

    private async Task DraftLetter(JobMatch match) => await DraftCoverLetterAsync(match.Id);

    private async Task SubmitApplication()
    {
        if (currentApplication is null) return;

        var appEntity = await Db.Applications.FindAsync(currentApplication.Id);
        if (appEntity is null) return;

        var externalUrl = currentApplication.JobMatch.JobPosting.ExternalUrl;

        _siteModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/site.js");

        if (!string.IsNullOrWhiteSpace(externalUrl))
        {
            await _siteModule.InvokeVoidAsync("openInNewTab", externalUrl);
        }
        await _siteModule.InvokeVoidAsync("copyToClipboard", currentApplication.CoverLetter);

        appEntity.Status = ApplicationStatus.Submitted;
        appEntity.SubmittedAt = DateTime.UtcNow;
        await Db.SaveChangesAsync();

        currentApplication.Status = ApplicationStatus.Submitted;
        currentApplication.SubmittedAt = appEntity.SubmittedAt;
    }

    // private async Task SubmitApplication()
    // {
    //     if (currentApplication is null) return;

    //     var appEntity = await Db.Applications.FindAsync(currentApplication.Id);
    //     if (appEntity is null) return;

    //     appEntity.Status = ApplicationStatus.Submitted;
    //     appEntity.SubmittedAt = DateTime.UtcNow;
    //     await Db.SaveChangesAsync();

    //     currentApplication.Status = ApplicationStatus.Submitted;
    //     currentApplication.SubmittedAt = appEntity.SubmittedAt;
    // }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/webmcp.js");
            _dotNetRef = DotNetObjectReference.Create(this);
            await _module.InvokeAsync<bool>("initWebMcp", _dotNetRef);
        }
        catch (JSDisconnectedException) { }
    }

    [JSInvokable]
    public async Task<string> ExecuteTool(string toolName, string argsJson)
    {
        try
        {
            switch (toolName)
            {
                case "parseResume":
                    {
                        var resume = await ParseResumeAsync();
                        return $"Parsed {resume.FileName}: {resume.MostRecentRole}, {resume.YearsExperience} yrs, skills: {string.Join(", ", resume.Skills)}";
                    }
                case "matchJobs":
                    {
                        var results = await MatchJobsAsync();
                        return string.Join("\n", results.Select(m =>
                            $"{m.JobPosting.Title} at {m.JobPosting.Company}: {m.MatchScore}% (matchId={m.Id}) — {m.Reasoning}"));
                    }
                case "draftCoverLetter":
                    {
                        using var doc = JsonDocument.Parse(string.IsNullOrWhiteSpace(argsJson) ? "{}" : argsJson);
                        if (!doc.RootElement.TryGetProperty("matchId", out var matchIdProp))
                            throw new InvalidOperationException("matchId is required.");
                        var matchId = matchIdProp.GetInt32();
                        return await DraftCoverLetterAsync(matchId);
                    }
                default:
                    throw new InvalidOperationException($"Unknown tool: {toolName}");
            }
        }
        catch (Exception ex)
        {
            return $"Error: {ex.Message}";
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("teardownWebMcp");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }

        _dotNetRef?.Dispose();
    }
}